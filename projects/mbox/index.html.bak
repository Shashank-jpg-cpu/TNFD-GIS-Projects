    <script>
        const DEFAULT_REPORTS = [{"id": "REP-007", "mbox_id": 2, "subject": "Human death on 09.09.2026 in Erode Division - Reg", "category": "Human Death", "icon_type": "human_death", "incident_date": "09/09/2026", "reported_date": "Fri, 11 Sep 2026 05:12:46 +0000 (UTC)", "location_name": "Erode Forest Division", "location_key": "erode", "has_exact_coords": false, "coord_source": "Central Location Fallback (Erode Forest Division)", "latitude": 11.362, "longitude": 77.6932, "pdf_attached": true, "pdf_filenames": ["document (94).pdf"], "body_snippet": "Sir/Madam,\nPlease find the attachments. \n\n\nWildlife Wing,\nO/o. the Principal Chief Conservator of Forests (Head of Forests Force),Guindy - Velachery Main Road,Chennai-32.", "pdf_snippet": "HOTNFD/7670/2026-WLA - JA 2 I/901887/2026\nத(cid:2)(cid:3)நா(cid:6) வன(cid:10)(cid:11)ைற\nஅ(cid:15)(cid:16)(cid:17)ந(cid:18) ெப(cid:21)ந(cid:18)\n(cid:22)(cid:23). ராேக(cid:28) (cid:29)மா(cid:18) ேடா(cid:32)ரா, இ.வ.ப., அர(cid:55) (cid:56)(cid:6)த(cid:57) தைலைம ெசயலாள(cid:18),\n(cid:35)த(cid:36)ைம தைலைம வன(cid:16)பா(cid:11)காவல(cid:18) (ம) (cid:55)(cid:58)(cid:21)(cid:59)(cid:60)ழ(cid:57), கால(cid:62)ைல மா(cid:58)ற(cid:45)\nதைலைம வன உ(cid:41)(cid:42)ன(cid:32)கா(cid:16)பாள(cid:18), ம(cid:58)(cid:21)(ci", "pdf_path": "pdfs/REP-007_document (94).pdf", "pdf_filename": "document (94).pdf"}, {"id": "REP-076", "subject": "Human Death: Mrs. Pavithra (23 yrs) due to Deer collision at Perundurai, Erode Division", "category": "Human Death", "icon_type": "human_death", "incident_date": "05/09/2026", "reported_date": "Recently Imported from Flash Report", "location_name": "Perundurai, Erode Range, Erode Division", "location_key": "erode", "has_exact_coords": true, "coord_source": "Exact GPS Coordinates (N11.284743, E77.562224)", "latitude": 11.284743, "longitude": 77.562224, "pdf_attached": false, "pdf_filenames": ["Flash_Report_Erode_Pavithra_05.09.2026.pdf"], "body_snippet": "Official Flash Report (Erode Division): Incident on 05.09.2026. Mrs. Pavithra (23 yrs), w/o Ramasamy, succumbed to fatal head injuries following a motorcycle collision involving deer at Perundurai, Erode Division. Underwent treatment at GEMCH hospital before succumbing at 11:30 PM. Exact GPS: N11.284743, E77.562224.", "pdf_snippet": "", "pdf_path": null, "pdf_filename": null}, {"id": "REP-063", "mbox_id": 64, "subject": "=?UTF-8?Q?Re=3A_Forest_=E2=80=93_Preparation_of_Management_Plan_for_Ka?=\n\t=?UTF-8?Q?davur_Slender_Loris_Sanctuary_=E2=80=93_Details_requested_=2D_regard?=\n\t=?UTF-8?Q?ing?=", "category": "Human Injury", "icon_type": "human_injury", "incident_date": "01/08/2026", "reported_date": "Sat, 1 Aug 2026 17:20:53 +0530", "location_name": "Dindigul Forest Division", "location_key": "dindigul", "has_exact_coords": false, "coord_source": "Central Location Fallback (Dindigul Forest Division)", "latitude": 10.3988, "longitude": 78.0223, "pdf_attached": true, "pdf_filenames": ["PATROLLING PATH.pdf", "SOIL CONSERVATION MAP.pdf"], "body_snippet": "Sir/Madam,\n\nPlease download the attachment.\n\nGeomatics Centre,\nO/o.Principal Chief Conservator of Forests,\n(HoFF), Velacherry,\nChennai\n\n\nOn Sat, Aug 1, 2026 at 5:19 PM GIS TNFD <gistnfd@gmail.com> wrote:\n\n> Sir/Madam,\n>\n> Please download the attachment.\n>\n> Geomatics Centre,\n> O/o.Principal Chief Conservator of Forests,\n> (HoFF), Velacherry,\n> Chennai\n>\n>\n> On Sat, Aug 1, 2026 at 5:18 PM GIS TNFD <gistnfd@gmail.com> wrote:\n>\n>> Sir/Madam,\n>>\n>> Please download the attachment.\n>>\n>> Geomatics Cen", "pdf_snippet": "±\nS L E N D E R L O R I S W I L D L I F E S A N C T U A R Y\nPATROLLING PATH MAP (KARUR AND AYYALUR RANGE)\nKARUR\nTIRUCHIRAPPALLI\nDINDIGUL\nLEGEND\nPATROLLING PATH\nEsri, NASA, NGA, USGS\nDIVISION BOUNDARY\nKM\n0 1 2 4 6 8 SANCTUARY BOUNDARY ±\nS L E N D E R L O R I S W I L D L I F E S A N C T U A R Y\nSOIL CONSERVATION MAP\nKARUR\nTIRUCHIRAPPALLI\nDINDIGUL\nLEGEND\nPERCOLATION POND\nCHECK DAM\nEsri, NASA, NGA, USGS\nDIVISION BOUNDARY\nKM\nSANCT