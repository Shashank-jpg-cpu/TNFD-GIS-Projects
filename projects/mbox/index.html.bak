        };

        const ANIMAL_PATTERNS = [
            { regex: /மான்|மான்கள்|deer|spotted deer|sambar|மா\$/i, name: 'Deer' },
            { regex: /யானை|காட்டுயானை|மக்னா|elephant|tusker|makna|யாைன/i, name: 'Wild Elephant' },
            { regex: /புலி|tiger/i, name: 'Tiger' },
            { regex: /சிறுத்தை|leopard/i, name: 'Leopard' },
            { regex: /காட்டு\s*மாடு|காட்டெருமை|கௌர்|gaur|bison/i, name: 'Wild Gaur (Bison)' },
            { regex: /காட்டுப்பன்றி|பன்றி|wild boar/i, name: 'Wild Boar' },
            { regex: /கரடி|bear|sloth bear/i, name: 'Sloth Bear' },
            { regex: /முதலை|crocodile/i, name: 'Crocodile' },
            { regex: /பாம்பு|snake|viper|cobra/i, name: 'Snake' }
        ];

        function transliterateTamil(tamText) {
            if (!tamText) return '';
            const vowels = {
                'அ': 'a', 'ஆ': 'aa', 'இ': 'i', 'ஈ': 'ee', 'உ': 'u', 'ஊ': 'oo',
                'எ': 'e', 'ஏ': 'ae', 'ஐ': 'ai', 'ஒ': 'o', 'ஓ': 'oe', 'ஔ': 'au'
            };
            const consonants = {
                'க': 'k', 'ங': 'ng', 'ச': 'ch', 'ஞ': 'nj', 'ட': 't', 'ண': 'n',
                'த': 'th', 'ந': 'n', 'ப': 'p', 'ம': 'm', 'ய': 'y', 'ர': 'r',
                'ல': 'l', 'வ': 'v', 'ழ': 'zh', 'ள': 'l', 'ற': 'r', 'ன': 'n',
                'ஜ': 'j', 'ஷ': 'sh', 'ஸ': 's', 'ஹ': 'h'
            };
            const matras = {
                'ா': 'a', 'ி': 'i', 'ீ': 'ee', 'ு': 'u', 'ூ': 'oo',
                'ெ': 'e', 'ே': 'ae', 'ை': 'ai', 'ொ': 'o', 'ோ': 'oe', 'ௌ': 'au',
                '்': ''
            };

            let result = '';
            for (let i = 0; i < tamText.length; i++) {
                const char = tamText[i];
                const nextChar = tamText[i + 1];

                if (vowels[char]) {
                    result += vowels[char];
                } else if (consonants[char]) {
                    const base = consonants[char];
                    if (nextChar && matras[nextChar] !== undefined) {
                        result += base + matras[nextChar];
                        i++;
                    } else {
                        result += base + 'a';
                    }
                } else {
                    result += char;
                }
            }
            return result.charAt(0).toUpperCase() + result.slice(1);
        }

        function parseReportDate(dateStr) {
            if (!dateStr || typeof dateStr !== 'string') return null;
            const str = dateStr.trim();
            if (!str || str.toLowerCase() === 'not specified' || str.toLowerCase() === 'null') return null;
            
            // Format 1: ISO YYYY-MM-DD
            const isoMatch = str.match(/^(\d{4})[-\/\.](\d{1,2})[-\/\.](\d{1,2})/);
            if (isoMatch) {
                const y = isoMatch[1];
                const m = isoMatch[2].padStart(2, '0');
                const d = isoMatch[3].padStart(2, '0');
                return `${y}-${m}-${d}`;
            }
            
            // Format 2: DD/MM/YYYY, DD.MM.YYYY, DD-MM-YYYY
            const dmyMatch = str.match(/^(\d{1,2})[-\/\.](\d{1,2})[-\/\.](\d{4})/);
            if (dmyMatch) {
                const d = dmyMatch[1].padStart(2, '0');
                const m = dmyMatch[2].padStart(2, '0');
                const y = dmyMatch[3];
                return `${y}-${m}-${d}`;
            }

            // Fallback: JS Date
            const dt = new Date(str);
            if (!isNaN(dt.getTime())) {
                const y = dt.getFullYear();
                const m = String(dt.getMonth() + 1).padStart(2, '0');
                const d = String(dt.getDate()).padStart(2, '0');
                return `${y}-${m}-${d}`;
            }
            return null;
        }

        function formatToDDMMYYYY(dateStr) {
            if (!dateStr) return 'N/A';
            const iso = parseReportDate(dateStr);
            if (!iso) return dateStr;
            const parts = iso.split('-');
            return `${parts[2]}/${parts[1]}/${parts[0]}`;
        }

        function sortReportsDesc(reports) {
            if (!Array.isArray(reports)) return [];
            return [...reports].sort((a, b) => {
                const dateA = parseReportDate(a.incident_date) || '1970-01-01';
                const dateB = parseReportDate(b.incident_date) || '1970-01-01';
                if (dateB !== dateA) {
                    return dateB.localeCompare(dateA); // Newest / most recent first
                }
                const idA = parseInt((a.id || '').replace(/\D/g, ''), 10) || 0;
                const idB = parseInt((b.id || '').replace(/\D/g, ''), 10) || 0;
                return idB - idA;
            });
        }

        function sanitizeDateInput(input) {
            if (!input) return;
            if (input.validity && (input.validity.rangeOverflow || input.validity.badInput)) {
                if (input.validity.rangeOverflow) {
                    input.value = input.max || '2030-12-31';
                } else if (input.validity.rangeUnderflow) {
                    input.value = input.min || '2020-01-01';
                }
                return;
            }
            const val = (input.value || '').trim();
            if (!val) return;
            const parts = val.split('-');
            if (parts.length === 3 && parts[0].length > 4) {
                parts[0] = parts[0].slice(0, 4);
                const yNum = parseInt(parts[0], 10);
                if (yNum > 2030) parts[0] = '2030';
                if (yNum < 2020) parts[0] = '2020';
                input.value = parts.join('-');
            }
        }

        let map = null;
        let markersLayer = null;
        let activeReports = [...DEFAULT_REPORTS];

        function loadStorageData() {
            try {
                const stored = localStorage.getItem('tn_forest_incidents_v23') || 
                               localStorage.getItem('tn_forest_incidents_v22') || 
                               localStorage.getItem('tn_forest_incidents_v21');
                if (stored) {
                    const parsed = JSON.parse(stored);
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        const defMap = new Map(DEFAULT_REPORTS.map(r => [r.id, r]));
                        const existingIds = new Set(parsed.map(r => r.id));
                        const missingDefaults = DEFAULT_REPORTS.filter(r => !existingIds.has(r.id));
                        const merged = [...missingDefaults, ...parsed.map(r => {
                            const def = defMap.get(r.id);
                            if (def) {
                                r.pdf_path = def.pdf_path || r.pdf_path || null;
                                r.pdf_filename = def.pdf_filename || r.pdf_filename || null;
                                r.pdf_attached = !!(r.pdf_path || def.pdf_path);
                            }
                            if (r.incident_date) {
                                r.incident_date = formatToDDMMYYYY(r.incident_date);
                            }
                            return r;
                        })];
                        const sorted = sortReportsDesc(merged);
                        saveStorageData(sorted);
                        return sorted;
                    }
                }
            } catch(e) {}
            const sortedDefaults = sortReportsDesc(DEFAULT_REPORTS);
            saveStorageData(sortedDefaults);
            return sortedDefaults;
        }

        function saveStorageData(data) {
            try {
                localStorage.setItem('tn_forest_incidents_v23', JSON.stringify(data));
            } catch(e) {}
        }

        function initMap() {
            if (map) return;
            try {
                map = L.map('map', {
                    center: [11.25, 77.20],
                    zoom: 8.5,
                    zoomControl: true
                });

                const streetMap = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}', {
                    maxZoom: 19,
                    attribution: 'Tiles &copy; Esri &mdash; Street Map'
                });

                const satelliteMap = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                    maxZoom: 19,
                    attribution: 'Tiles &copy; Esri &mdash; Satellite View'
                });

                const topoMap = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}', {
                    maxZoom: 19,
                    attribution: 'Tiles &copy; Esri &mdash; Topo Map'
                });

                streetMap.addTo(map);

                L.control.layers({
                    "Standard Street Map": streetMap,
                    "Satellite View": satelliteMap,
                    "Topographic Forest Map": topoMap
                }, null, { position: 'topright' }).addTo(map);

                markersLayer = L.featureGroup().addTo(map);
            } catch(e) {
                console.error("Map initialization error:", e);
            }
        }

        function updateStats(reports) {
            const list = reports || [];
            const total = list.length;
            const humanDeaths = list.filter(r => r.category === 'Human Death').length;
            const humanInjuries = list.filter(r => r.category === 'Human Injury').length;
            const animalDeaths = list.filter(r => r.category === 'Animal Death').length;
            const animalInjuries = list.filter(r => r.category === 'Animal Injury').length;

            const elTotal = document.getElementById('stat-total');
            const elHD = document.getElementById('stat-human-deaths');
            const elHI = document.getElementById('stat-human-injuries');
            const elAD = document.getElementById('stat-animal-deaths');
            const elAI = document.getElementById('stat-animal-injuries');

            if (elTotal) elTotal.innerText = total;
            if (elHD) elHD.innerText = humanDeaths;
            if (elHI) elHI.innerText = humanInjuries;
            if (elAD) elAD.innerText = animalDeaths;
            if (elAI) elAI.innerText = animalInjuries;
        }

        function renderReports(reports) {
            if (markersLayer) markersLayer.clearLayers();
            const listContainer = document.getElementById('reports-list');
            const countEl = document.getElementById('visible-count');
            const mobileCountEl = document.getElementById('mobile-count-badge');
            
            if (listContainer) listContainer.innerHTML = '';
            if (countEl) countEl.innerText = reports.length;
            if (mobileCountEl) mobileCountEl.innerText = reports.length;

            if (reports.length === 0) {
                if (listContainer) {
                    listContainer.innerHTML = `<div class="p-8 text-center text-slate-500 text-sm"><i class="fa-solid fa-folder-open text-2xl mb-2 text-slate-600 block"></i>No matching incident reports found.</div>`;
                }
                return;
            }

            reports.forEach(report => {
                let marker = null;
                if (markersLayer) {
                    marker = createMarker(report);
                    markersLayer.addLayer(marker);
                }

                if (listContainer) {
                    const card = createSidebarCard(report, marker);
                    listContainer.appendChild(card);
                }
            });

            if (map && markersLayer && markersLayer.getLayers().length > 0) {
                try {
                    map.fitBounds(markersLayer.getBounds().pad(0.1));
                } catch(e) {}
            }
        }

        function createMarker(report) {
            let iconClass = 'marker-human-death';
            let iconFa = 'fa-skull-crossbones';

            if (report.category === 'Human Death') {
                iconClass = 'marker-human-death';
                iconFa = 'fa-skull-crossbones';
            } else if (report.category === 'Human Injury') {
                iconClass = 'marker-human-injury';
                iconFa = 'fa-user-injured';
            } else if (report.category === 'Animal Death') {
                iconClass = 'marker-animal-death';
                iconFa = 'fa-paw';
            } else if (report.category === 'Animal Injury') {
                iconClass = 'marker-animal-injury';
                iconFa = 'fa-kit-medical';
            }

            const badgeClass = report.has_exact_coords ? 'badge-gps' : 'badge-fix';
            const badgeText = report.has_exact_coords ? 'GPS' : 'FIX';

            const customIcon = L.divIcon({
                className: '',
                html: `
                    <div class="custom-marker-icon ${iconClass} w-8 h-8 relative">
                        <i class="fa-solid ${iconFa} text-xs"></i>
                        <span class="marker-badge ${badgeClass}">${badgeText}</span>
                    </div>
                `,
                iconSize: [32, 32],
                iconAnchor: [16, 16]
            });

            const marker = L.marker([report.latitude, report.longitude], { icon: customIcon });

            let badgeColor = 'bg-rose-950 text-rose-400 border-rose-800';
            if (report.category === 'Human Injury') badgeColor = 'bg-amber-950 text-amber-400 border-amber-800';
            if (report.category === 'Animal Death') badgeColor = 'bg-purple-950 text-purple-400 border-purple-800';
            if (report.category === 'Animal Injury') badgeColor = 'bg-cyan-950 text-cyan-400 border-cyan-800';

            const popupContent = `
                <div class="p-3.5 space-y-2.5 font-sans">
                    <div class="flex items-start justify-between gap-2 border-b border-slate-800 pb-2">
                        <div>
                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">${report.id}</span>
                            <h3 class="text-xs font-bold text-white leading-snug">${escapeHtml(report.subject)}</h3>
                        </div>
                        <span class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase border shrink-0 ${badgeColor}">
                            ${report.category}
                        </span>
                    </div>

                    <div class="bg-slate-950 p-2 rounded border border-slate-800/80 flex items-center justify-between text-xs">
                        <span class="text-slate-400 text-[11px]"><i class="fa-regular fa-calendar mr-1 text-emerald-400"></i>Date:</span>
                        <span class="text-white font-semibold">${formatToDDMMYYYY(report.incident_date)}</span>
                    </div>

                    <div class="flex items-center gap-2 pt-1 border-t border-slate-800">
                        ${report.pdf_path ? `
                        <button onclick="downloadReportPdfById('${report.id}')" class="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white py-1.5 rounded text-xs font-semibold transition flex items-center justify-center gap-1.5 shadow">
                            <i class="fa-solid fa-file-pdf"></i> Download PDF
                        </button>` : ``}
                        <button onclick="deleteReport('${report.id}')" class="bg-rose-600/20 hover:bg-rose-600 text-rose-400 hover:text-white border border-rose-600/40 px-2.5 py-1.5 rounded text-xs font-semibold transition" title="Delete Report">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </div>
                </div>
            `;

            marker.bindPopup(popupContent, { maxWidth: 320 });
            return marker;
        }

        function createSidebarCard(report, marker) {
            const card = document.createElement('div');
            card.className = 'p-3 hover:bg-slate-900/90 transition flex flex-col space-y-2 group border-b border-slate-800/50';

            let categoryBadge = 'bg-rose-950/80 text-rose-400 border-rose-800/60';
            if (report.category === 'Human Injury') categoryBadge = 'bg-amber-950/80 text-amber-400 border-amber-800/60';
            if (report.category === 'Animal Death') categoryBadge = 'bg-purple-950/80 text-purple-400 border-purple-800/60';
            if (report.category === 'Animal Injury') categoryBadge = 'bg-cyan-950/80 text-cyan-400 border-cyan-800/60';

            card.innerHTML = `
                <div class="flex items-center justify-between gap-2">
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold border ${categoryBadge}">
                        ${report.category}
                    </span>
                    <span class="text-[11px] font-semibold text-slate-300 flex items-center gap-1">
                        <i class="fa-regular fa-calendar-check text-emerald-400 text-[11px]"></i>
                        ${formatToDDMMYYYY(report.incident_date)}
                    </span>
                </div>

                <h4 class="text-xs font-bold text-slate-200 group-hover:text-emerald-400 transition leading-snug line-clamp-2">
                    ${escapeHtml(report.subject)}
                </h4>

                <div class="text-[11px] text-slate-400 flex items-center justify-between">
                    <span class="truncate"><i class="fa-solid fa-location-dot text-slate-500 mr-1"></i>${escapeHtml(report.location_name)}</span>
                </div>

                <div class="flex items-center justify-between gap-2 pt-1 border-t border-slate-900/80">
                    <button class="btn-locate bg-slate-800 hover:bg-slate-700 text-slate-300 px-2.5 py-1 rounded text-[11px] font-semibold transition flex items-center gap-1">
                        <i class="fa-solid fa-crosshairs text-emerald-400"></i> Locate
                    </button>
                    ${report.pdf_path ? `
                    <button onclick="event.stopPropagation(); downloadReportPdfById('${report.id}');" class="btn-download-pdf bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-1.5 rounded text-xs font-semibold transition flex items-center gap-1.5 shadow">
                        <i class="fa-solid fa-file-pdf"></i> Download PDF
                    </button>` : ``}
                </div>
            `;

            card.querySelector('.btn-locate').addEventListener('click', (e) => {
                e.stopPropagation();
                if (window.innerWidth <= 768) setMobileTab('map');
                if (map && marker) {
                    map.setView([report.latitude, report.longitude], 12, { animate: true });
                    marker.openPopup();
                }
            });

            const pdfBtn = card.querySelector('.btn-download-pdf');
            if (pdfBtn) {
                pdfBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    downloadReportPdf(report);
                });
            }

            card.addEventListener('click', (e) => {
                if (e.target && (e.target.closest('.btn-download-pdf') || e.target.closest('.btn-locate'))) return;
                if (window.innerWidth <= 768) setMobileTab('map');
                if (map && marker) {
                    map.setView([report.latitude, report.longitude], 12, { animate: true });
                    marker.openPopup();
                }
            });

            return card;
        }

        function downloadReportPdfById(id) {
            const rep = activeReports.find(r => r.id === id);
            if (rep) downloadReportPdf(rep);
        }

        function downloadReportPdf(report) {
            // ONLY download official attached PDF from mail - do not generate any synthetic PDF
            if (!report || !report.pdf_path) {
                return;
            }

            const targetFilename = report.pdf_filename || `${report.id}.pdf`;

            // If running inside Android App WebView Bridge
            if (window.AndroidBlobDownloader && typeof window.AndroidBlobDownloader.downloadAssetFile === 'function') {
                const assetPath = "projects/mbox/" + report.pdf_path;
                window.AndroidBlobDownloader.downloadAssetFile(assetPath, targetFilename, "application/pdf");
                return;
            }

            // Standard Web browser download
            const a = document.createElement('a');
            a.href = report.pdf_path;
            a.download = targetFilename;
            a.target = '_blank';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        function deleteReport(reportId) {
            if (!confirm(`Are you sure you want to delete report ${reportId}?`)) return;
            activeReports = activeReports.filter(r => r.id !== reportId);
            saveStorageData(activeReports);
            applyFilters();
        }

        function applyFilters() {
            const searchInput = document.getElementById('search-input');
            const filterCat = document.getElementById('filter-category');
            const filterLoc = document.getElementById('filter-location');
            const dateFromInput = document.getElementById('filter-date-from');
            const dateToInput = document.getElementById('filter-date-to');

            // Sanitize any 5-digit years typed in inputs
            if (dateFromInput) sanitizeDateInput(dateFromInput);
            if (dateToInput) sanitizeDateInput(dateToInput);

            const query = (searchInput && searchInput.value || '').toLowerCase().trim();
            const catVal = filterCat && filterCat.value || 'ALL';
            const locVal = filterLoc && filterLoc.value || 'ALL';
            let dateFrom = dateFromInput && dateFromInput.value || '';
            let dateTo = dateToInput && dateToInput.value || '';

            if (dateFrom && dateFrom.split('-')[0].length > 4) {
                dateFrom = dateFrom.split('-')[0].slice(0, 4) + '-' + dateFrom.split('-').slice(1).join('-');
            }
            if (dateTo && dateTo.split('-')[0].length > 4) {
                dateTo = dateTo.split('-')[0].slice(0, 4) + '-' + dateTo.split('-').slice(1).join('-');
            }

            const filtered = activeReports.filter(report => {
                const matchesQuery = !query || 
                    (report.subject && report.subject.toLowerCase().includes(query)) ||
                    (report.location_name && report.location_name.toLowerCase().includes(query)) ||
                    (report.id && report.id.toLowerCase().includes(query)) ||
                    (report.body_snippet && report.body_snippet.toLowerCase().includes(query));

                const matchesCat = catVal === 'ALL' || report.category === catVal;
                const matchesLoc = locVal === 'ALL' || report.location_key === locVal || (report.location_name && report.location_name.toLowerCase().includes(locVal));

                let matchesDate = true;
                if (dateFrom || dateTo) {
                    const parsed = parseReportDate(report.incident_date);
                    if (parsed) {
                        if (dateFrom && parsed < dateFrom) matchesDate = false;
                        if (dateTo && parsed > dateTo) matchesDate = false;
                    } else {
                        matchesDate = false;
                    }
                }

                return matchesQuery && matchesCat && matchesLoc && matchesDate;
            });

            const sortedFiltered = sortReportsDesc(filtered);
            updateStats(sortedFiltered);
            renderReports(sortedFiltered);
        }

        function resetAllFilters() {
            const searchInput = document.getElementById('search-input');
            const filterCat = document.getElementById('filter-category');
            const filterLoc = document.getElementById('filter-location');
            const dateFromInput = document.getElementById('filter-date-from');
            const dateToInput = document.getElementById('filter-date-to');

            if (searchInput) searchInput.value = '';
            if (filterCat) filterCat.value = 'ALL';
            if (filterLoc) filterLoc.value = 'ALL';
            if (dateFromInput) dateFromInput.value = '';
            if (dateToInput) dateToInput.value = '';

            activeReports = loadStorageData();
            applyFilters();
        }

        function setupEventListeners() {
            const searchInput = document.getElementById('search-input');
            const filterCat = document.getElementById('filter-category');
            const filterLoc = document.getElementById('filter-location');
            const dateFromInput = document.getElementById('filter-date-from');
            const dateToInput = document.getElementById('filter-date-to');
            const btnResetDates = document.getElementById('btn-reset-dates');
            const btnShowAll = document.getElementById('btn-show-all-data');

            if (searchInput) searchInput.addEventListener('input', applyFilters);
            if (filterCat) filterCat.addEventListener('change', applyFilters);
            if (filterLoc) filterLoc.addEventListener('change', applyFilters);

            if (dateFromInput) {
                dateFromInput.addEventListener('input', () => {
                    sanitizeDateInput(dateFromInput);
                    applyFilters();
                });
                dateFromInput.addEventListener('change', () => {
                    sanitizeDateInput(dateFromInput);
                    applyFilters();
                });
                dateFromInput.addEventListener('blur', () => {
                    sanitizeDateInput(dateFromInput);
                    applyFilters();
                });
            }
            if (dateToInput) {
                dateToInput.addEventListener('input', () => {
                    sanitizeDateInput(dateToInput);
                    applyFilters();
                });
                dateToInput.addEventListener('change', () => {
                    sanitizeDateInput(dateToInput);
                    applyFilters();
                });
                dateToInput.addEventListener('blur', () => {
                    sanitizeDateInput(dateToInput);
                    applyFilters();
                });
            }

            if (btnResetDates) {
                btnResetDates.addEventListener('click', () => {
                    if (dateFromInput) dateFromInput.value = '';
                    if (dateToInput) dateToInput.value = '';
                    applyFilters();
                });
            }

            if (btnShowAll) {
                btnShowAll.addEventListener('click', () => {
                    resetAllFilters();
                });
            }

            const modalImport = document.getElementById('modal-import');
            const modalManual = document.getElementById('modal-manual');

            const btnOpenImport = document.getElementById('btn-open-import');
            const btnOpenManual = document.getElementById('btn-open-manual');

            if (btnOpenImport) btnOpenImport.addEventListener('click', () => modalImport.classList.remove('hidden'));
            if (btnOpenManual) btnOpenManual.addEventListener('click', () => modalManual.classList.remove('hidden'));

            document.querySelectorAll('.btn-close-modal').forEach(btn => {
                btn.addEventListener('click', () => {
                    if (modalImport) modalImport.classList.add('hidden');
                    if (modalManual) modalManual.classList.add('hidden');
                });
            });

            // Import Form
            const formImport = document.getElementById('form-import');
            if (formImport) {
                formImport.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const fileInput = document.getElementById('import-file-input');
                    const subjectInput = document.getElementById('import-subject');
                    const textInput = document.getElementById('import-text');

                    let importedText = textInput.value || '';
                    let fileName = 'Imported Report';
                    const file = fileInput.files[0];

                    if (file) {
                        fileName = file.name;
                        if (fileName.toLowerCase().endsWith('.pdf')) {
                            importedText += " " + await readPdfText(file);
                        } else {
                            importedText += " " + await file.text();
                        }
                    }

                    const rawSubject = subjectInput.value || (fileName !== 'Imported Report' ? `Flash Report: ${fileName}` : 'Imported Flash Report');
                    let cleanText = importedText.replace(/Content-Transfer-Encoding:\s*base64[\s\S]*?(?=[\r\n]{2,}|$)/gi, '');
                    const combined = (rawSubject + " " + cleanText);
                    const combinedLower = combined.toLowerCase();
                    const isTamil = /[\u0B80-\u0BFF]/.test(combined);

                    // Category detection (English + Tamil Unicode + eOffice font glyphs)
                    const humanDeathTamil = /(உயிரிழந்துள்ளார்|உயிரிழந்தார்|உயிரிழப்பு|இறந்துள்ளார்|இறந்தார்|மரணமடைந்தார்|மரணம்|கொல்லப்பட்டார்|உயிர்\s*இழந்தார்|சிகிச்சை\s*பலனின்றி|உ\)\*ழ)/i;
                    const humanInjuryTamil = /(காயமடைந்தார்|காயமடைந்து|காயம்|பலத்த\s*காயம்|அடிபட்டார்|தாக்கப்பட்டார்|சிகிச்சை\s*பெற்று|தாக்கியதில்|காயமைட|காய#)/i;
                    const animalDeathTamil = /(யானை\s*(?:உயிரிழப்பு|இறப்பு)|புலி\s*(?:உயிரிழப்பு|இறப்பு)|சிறுத்தை\s*(?:உயிரிழப்பு|இறப்பு)|மான்\s*(?:உயிரிழப்பு|இறப்பு)|விலங்கு\s*உயிரிழப்பு|உடற்கூறாய்வு|அழுகிய\s*சடலம்|சடலமாக|இறந்த\s*நிலையில்|(?:யானை|புலி|சிறுத்தை|மான்|விலங்கு)[^\n\r]{0,30}உ\)\*ழ)/i;
                    const animalInjuryTamil = /(யானை\s*காயம்|புலி\s*காயம்|சிறுத்தை\s*காயம்|மான்\s*காயம்|விலங்கு\s*காயம்|காயமடைந்த\s*வனவிலங்கு)/i;

                    const hasHumanDeath = /(human death|one human|person died|killed by elephant|killed by tiger|killed by leopard|killed by wildlife|man died|woman death|fatal attack|succumbed)/i.test(combinedLower) || humanDeathTamil.test(combined);
                    const hasHumanInjury = /(human injury|injured by elephant|injured by tiger|injured by leopard|injured by wildlife|person injured|man injured|woman injured)/i.test(combinedLower) || (humanInjuryTamil.test(combined) && !hasHumanDeath);
                    const hasAnimalDeath = /(animal death|elephant death|male elephant death|female elephant death|tiger death|leopard death|gaur death|wildlife death|carcass|post-mortem)/i.test(combinedLower) || animalDeathTamil.test(combined);
                    const hasAnimalInjury = /(animal injury|elephant injury|tiger injury|leopard injury|gaur injury|wildlife injury)/i.test(combinedLower) || animalInjuryTamil.test(combined);

                    let category = null;
                    if (hasHumanDeath) category = 'Human Death';
                    else if (hasHumanInjury) category = 'Human Injury';
                    else if (hasAnimalDeath) category = 'Animal Death';
                    else if (hasAnimalInjury) category = 'Animal Injury';

                    if (!category) {
                        if (/(vc meeting|meeting for discussion|demo completion|proposal submitted|preparation of management)/i.test(combinedLower)) {
                            alert("⚠️ IMPORT REJECTED:\n\nAdministrative or meeting emails are not permitted.\nOnly Human Death, Human Injury, Animal Death, and Animal Injury reports are allowed.");
                            return;
                        }
                        if (file && (!cleanText || cleanText.trim().length === 0)) {
                            alert("⚠️ PDF TEXT NOT READABLE:\n\nCould not extract readable text from the uploaded PDF.\nPlease paste the report text into the box below and click Detect & Import.");
                            return;
                        }
                        alert("⚠️ IMPORT REJECTED:\n\nCould not detect an incident type.\nImported content must contain details of: Human Death, Human Injury, Animal Death, or Animal Injury.");
                        return;
                    }

                    // Animal detection
                    let detectedAnimal = 'Wildlife';
                    for (const item of ANIMAL_PATTERNS) {
                        if (item.regex.test(combined)) {
                            detectedAnimal = item.name;
                            break;
                        }
                    }

                    // Location detection (Tamil mapping first, fallback to English CENTRAL_COORDS)
                    let detectedLocKey = null;
                    let detectedLocDisplay = null;

                    if (isTamil || /ERDDIV|GEMCH|ஈேரா/i.test(combined)) {
                        let locParts = [];
                        for (const [tamName, info] of Object.entries(TAMIL_GEO_MAP)) {
                            if (combined.includes(tamName)) {
                                if (info.location && !locParts.includes(info.location)) locParts.push(info.location);
                                if (info.range && !locParts.includes(info.range)) locParts.push(info.range);
                                if (info.division && !locParts.includes(info.division)) locParts.push(info.division);
                                if (!detectedLocKey && info.key) detectedLocKey = info.key;
                            }
                        }
                        if (locParts.length > 0) {
                            detectedLocDisplay = locParts.join(', ');
                        }
                    }

                    if (!detectedLocDisplay) {
                        for (const [key, info] of Object.entries(CENTRAL_COORDS)) {
                            if (new RegExp('\\b' + key + '\\b', 'i').test(combinedLower)) {
                                detectedLocKey = key;
                                detectedLocDisplay = info.name;
                                break;
                            }
                        }
                    }
                    if (!detectedLocKey) detectedLocKey = 'hasanur';
                    if (!detectedLocDisplay) detectedLocDisplay = CENTRAL_COORDS[detectedLocKey] ? CENTRAL_COORDS[detectedLocKey].name : 'Tamil Nadu Forest Area';

                    // GPS Coordinates Extraction: Support N11.284743, E77.562224, 11.284743, 77.562224, Lat 11.284743 Long 77.562224
                    let lat = null, lng = null, hasExact = false, coordSource = '';
                    const coordRegex = /(?:[Nn]|lat(?:itude)?)?\s*([89]\.\d{3,8}|1[0-4]\.\d{3,8})[^\dNSEnse]{1,25}(?:[Ee]|long(?:itude)?)?\s*(7[5-9]\.\d{3,8}|8[01]\.\d{3,8})/i;
                    const pairMatch = combined.match(coordRegex);
                    if (pairMatch) {
                        lat = parseFloat(pairMatch[1]);
                        lng = parseFloat(pairMatch[2]);
                        hasExact = true;
                        coordSource = `Exact GPS Coordinates (N${lat.toFixed(6)}, E${lng.toFixed(6)})`;

                        // Coordinate-based location refinement
                        if (lat >= 11.2 && lat <= 11.45 && lng >= 77.45 && lng <= 77.85) {
                            detectedLocKey = 'erode';
                            if (!detectedLocDisplay.includes('Perundurai')) {
                                detectedLocDisplay = 'Perundurai, Erode Range, Erode Division';
                            }
                        }
                    } else {
                        const base = CENTRAL_COORDS[detectedLocKey] || CENTRAL_COORDS['hasanur'];
                        lat = base.lat + (activeReports.length % 10 - 5) * 0.003;
                        lng = base.lng + (activeReports.length % 8 - 4) * 0.003;
                        coordSource = `Central Location Fallback (${base.name})`;
                    }

                    // Incident Date Extraction
                    const dateMatch = combined.match(/(\d{1,2}[\.\/\-]\d{1,2}[\.\/\-]\d{4})/);
                    const incDate = dateMatch ? formatToDDMMYYYY(dateMatch[1]) : '10/07/2026';

                    // Translate / Synthesize details into English if report is in Tamil
                    let subject = rawSubject;
                    let bodySnippet = cleanText.slice(0, 500) || rawSubject;

                    if (isTamil || /பV\s*ரா|பவித்ரா|GEMCH|ERDDIV|உ\)\*ழ/i.test(combined)) {
                        let victimStr = '';
                        const victimMatch = combined.match(/(?:திருமதி|திரு|செல்வி)\.?\s*([\u0B80-\u0BFA]+)/);
                        if (victimMatch) {
                            const rawTitle = victimMatch[0].includes('திருமதி') ? 'Mrs.' : (victimMatch[0].includes('செல்வி') ? 'Ms.' : 'Mr.');
                            const transliteratedName = transliterateTamil(victimMatch[1].trim());
                            victimStr = `${rawTitle} ${transliteratedName}`;
                        } else if (/பV\s*ரா|பவித்ரா/i.test(combined)) {
                            victimStr = 'Mrs. Pavithra';
                        }
                        const ageMatch = combined.match(/வய[^\d]*(?:7\s*மா|சுமார்|[^\d])*\s*(\d{1,2})\b/i) || combined.match(/வய[^\)]*?\b(\d{1,2})\s*\)/i);
                        if (ageMatch) {
                            victimStr += (victimStr ? ` (${ageMatch[1]} yrs)` : `Victim (${ageMatch[1]} yrs)`);
                        }

                        if (category === 'Human Death') {
                            subject = `Human Death: ${victimStr ? victimStr + ' ' : ''}due to ${detectedAnimal} collision/encounter at ${detectedLocDisplay}`;
                            bodySnippet = `Official Flash Report (${detectedLocDisplay}): Incident occurred on ${incDate}. ${victimStr || 'A person'} succumbed to fatal injuries following an incident involving ${detectedAnimal}. ${hasExact ? `Exact GPS: N${lat.toFixed(6)}, E${lng.toFixed(6)}.` : ''}`;
                        } else if (category === 'Human Injury') {
                            subject = `Human Injury: ${victimStr ? victimStr + ' ' : ''}injured by ${detectedAnimal} at ${detectedLocDisplay}`;
                            bodySnippet = `Official Flash Report (${detectedLocDisplay}): Incident on ${incDate}. ${victimStr || 'A person'} sustained injuries caused by ${detectedAnimal}. Under medical care. ${hasExact ? `Exact GPS: N${lat.toFixed(6)}, E${lng.toFixed(6)}.` : ''}`;
                        } else if (category === 'Animal Death') {
                            subject = `Animal Death: ${detectedAnimal} carcass reported at ${detectedLocDisplay}`;
                            bodySnippet = `Official Flash Report (${detectedLocDisplay}): Carcass of ${detectedAnimal} reported on ${incDate}. Post-mortem and forest team dispatched. ${hasExact ? `Exact GPS: N${lat.toFixed(6)}, E${lng.toFixed(6)}.` : ''}`;
                        } else {
                            subject = `Animal Injury: ${detectedAnimal} injured at ${detectedLocDisplay}`;
                            bodySnippet = `Official Flash Report (${detectedLocDisplay}): ${detectedAnimal} reported injured on ${incDate}. Veterinary treatment underway. ${hasExact ? `Exact GPS: N${lat.toFixed(6)}, E${lng.toFixed(6)}.` : ''}`;
                        }
                    }

                    const existingIndex = activeReports.findIndex(r => r.subject.toLowerCase().trim() === subject.toLowerCase().trim());
                    
                    let isOverwrite = false;
                    let reportId = `REP-${String(activeReports.length + 1).padStart(3, '0')}`;
                    
                    if (existingIndex !== -1) {
                        isOverwrite = true;
                        reportId = activeReports[existingIndex].id;
                    }

                    const hasPdfFile = file && file.name && file.name.toLowerCase().endsWith('.pdf');
                    const newReport = {
                        id: reportId,
                        subject: subject,
                        category: category,
                        icon_type: category.toLowerCase().replace(' ', '_'),
                        incident_date: incDate,
                        reported_date: 'Just now',
                        location_name: detectedLocDisplay,
                        location_key: detectedLocKey || 'hasanur',
                        has_exact_coords: hasExact,
                        coord_source: coordSource,
                        latitude: Number(lat.toFixed(6)),
                        longitude: Number(lng.toFixed(6)),
                        pdf_attached: hasPdfFile,
                        pdf_path: hasPdfFile ? URL.createObjectURL(file) : null,
                        pdf_filename: hasPdfFile ? file.name : null,
                        body_snippet: bodySnippet,
                        pdf_snippet: ""
                    };

                    if (isOverwrite) {
                        activeReports[existingIndex] = newReport;
                    } else {
                        activeReports.unshift(newReport);
                    }

                    activeReports = sortReportsDesc(activeReports);
                    saveStorageData(activeReports);
                    applyFilters();

                    if (modalImport) modalImport.classList.add('hidden');
                    formImport.reset();
                    if (map) map.setView([newReport.latitude, newReport.longitude], 12);
                    
                    if (isOverwrite) {
                        alert("🔄 Existing Report Overwritten! Updated: " + subject);
                    } else {
                        alert("✅ Successfully Imported! Classified as: " + category + (isTamil ? "\n🌐 Translated & Located in English." : ""));
                    }
                });
            }

            // Manual Form
            const formManual = document.getElementById('form-manual');
            if (formManual) {
                formManual.addEventListener('submit', (e) => {
                    e.preventDefault();
                    const category = document.getElementById('manual-category').value;
                    const subject = document.getElementById('manual-subject').value;
                    
                    const existingIndex = activeReports.findIndex(r => r.subject.toLowerCase().trim() === subject.toLowerCase().trim());
                    let reportId = existingIndex !== -1 ? activeReports[existingIndex].id : `REP-${String(activeReports.length + 1).padStart(3, '0')}`;

                    const rawIncDate = document.getElementById('manual-inc-date').value;
                    const incDate = rawIncDate ? formatToDDMMYYYY(rawIncDate) : '10/07/2026';

                    const newReport = {
                        id: reportId,
                        subject: subject,
                        category: category,
                        location_name: document.getElementById('manual-location').value,
                        latitude: parseFloat(document.getElementById('manual-lat').value),
                        longitude: parseFloat(document.getElementById('manual-lng').value),
                        incident_date: incDate,
                        reported_date: document.getElementById('manual-rep-date').value || 'Today',
                        body_snippet: document.getElementById('manual-details').value || 'Manually added flash report.',
                        has_exact_coords: true,
                        coord_source: "Manual Lat/Lng Entry",
                        pdf_attached: false,
                        pdf_path: null,
                        pdf_filename: null
                    };

                    if (existingIndex !== -1) {
                        activeReports[existingIndex] = newReport;
                    } else {
                        activeReports.unshift(newReport);
                    }

                    activeReports = sortReportsDesc(activeReports);
                    saveStorageData(activeReports);
                    applyFilters();

                    if (modalManual) modalManual.classList.add('hidden');
                    formManual.reset();
                    if (map) map.setView([newReport.latitude, newReport.longitude], 12);
                });
            }

            // Mobile Tab Switchers
            const tabBtnList = document.getElementById('tab-btn-list');
            const tabBtnMap = document.getElementById('tab-btn-map');
            const btnBackToList = document.getElementById('btn-mobile-back-to-list');

            if (tabBtnList) tabBtnList.addEventListener('click', () => setMobileTab('list'));
            if (tabBtnMap) tabBtnMap.addEventListener('click', () => setMobileTab('map'));
            if (btnBackToList) btnBackToList.addEventListener('click', () => setMobileTab('list'));
        }

        function setMobileTab(tab) {
            const sidebar = document.getElementById('sidebar');
            const tabBtnList = document.getElementById('tab-btn-list');
            const tabBtnMap = document.getElementById('tab-btn-map');
            if (!sidebar) return;
            
            if (tab === 'map') {
                sidebar.classList.add('mobile-map-active');
                if (tabBtnList) tabBtnList.className = 'flex-1 py-2 px-3 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1.5 bg-slate-900 text-slate-300 hover:text-white border border-slate-800';
                if (tabBtnMap) tabBtnMap.className = 'flex-1 py-2 px-3 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1.5 bg-emerald-600 text-white shadow';
                if (map) {
                    setTimeout(() => { map.invalidateSize(); }, 250);
                }
            } else {
                sidebar.classList.remove('mobile-map-active');
                if (tabBtnList) tabBtnList.className = 'flex-1 py-2 px-3 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1.5 bg-emerald-600 text-white shadow';
                if (tabBtnMap) tabBtnMap.className = 'flex-1 py-2 px-3 rounded-lg text-xs font-bold transition flex items-center justify-center gap-1.5 bg-slate-900 text-slate-300 hover:text-white border border-slate-800';
            }
        }

        function startApp() {
            activeReports = loadStorageData();
            initMap();
            setupEventListeners();
            
            const searchInput = document.getElementById('search-input');
            const filterCat = document.getElementById('filter-category');
            const filterLoc = document.getElementById('filter-location');
            const dateFromInput = document.getElementById('filter-date-from');
            const dateToInput = document.getElementById('filter-date-to');
            
            if (searchInput) searchInput.value = '';
            if (filterCat) filterCat.value = 'ALL';
            if (filterLoc) filterLoc.value = 'ALL';
            if (dateFromInput) dateFromInput.value = '';
            if (dateToInput) dateToInput.value = '';

            applyFilters();
        }

        document.addEventListener('DOMContentLoaded', startApp);
        window.addEventListener('pageshow', startApp);

        async function readPdfText(file) {
            try {
                const arrayBuffer = await file.arrayBuffer();
                if (typeof pdfjsLib !== 'undefined') {
                    if (pdfjsLib.GlobalWorkerOptions) {
                        pdfjsLib.GlobalWorkerOptions.workerSrc = './pdf.worker.min.js';
                    }
                    const loadingTask = pdfjsLib.getDocument({
                        data: new Uint8Array(arrayBuffer),
                        disableFontFace: true,
                        useSystemFonts: true
                    });
                    const pdf = await loadingTask.promise;
                    let fullText = '';
                    for (let i = 1; i <= Math.min(5, pdf.numPages); i++) {
                        const page = await pdf.getPage(i);
                        const textContent = await page.getTextContent();
                        fullText += textContent.items.map(item => item.str).join(' ') + ' ';
                    }
                    if (fullText.trim()) return fullText;
                }
            } catch(e) {
                console.warn("pdf.js extraction error:", e);
            }
            return '';
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }
    </script>
</body>
</html>
